/android/app/debug
/android/app/profile
/android/app/release

# Firebase client config — tied to a specific Firebase project/app. Keeping
# it out of version control avoids leaking which Firebase project this app
# is wired to; anyone cloning the repo should drop in their own (see
# README's Firebase setup section).
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
